  <div class="container">
    <div class="sidebar">
      <h3>Upload File</h3><br><br>
      <form id="uploadForm">
        <input type="file" id="fileInput" accept=".pdf,.txt,.docx" />
        <button type="submit">Upload</button>
      </form>
      <div class="drop-zone" id="dropZone" tabindex="0">
        👉 Drag & Drop or Paste Files Here
        <br /><br />
        📋 Try pasting a PDF or DOCX or Doc or pressing <strong>Ctrl+V</strong> to upload
      </div>
    </div>

    <div class="main">
      <h3>Files</h3>
      <div id="fileList" class="grid"></div>
    </div>
  </div>

  <div class="footer">Copyright@2025 MEC Digital Archive </div>

  <div class="modal" id="modal">
    <div class="modal-close" id="modalClose">&times;</div>
    <div class="modal-content" id="modalContent"></div>
    <div class="zoom-controls" id="zoomControls" style="display:none;">
      <button id="zoomOutBtn">−</button>
      <button id="zoomInBtn">+</button>
      <button id="zoomResetBtn">Reset</button>
    </div>
  </div>

  <script>
 function handleFile(file) {
  const MAX_FILE_SIZE = 50 * 1024 * 1024; // 50MB

  if (file.size > MAX_FILE_SIZE) {
    alert(`❌ File "${file.name}" is too large! Please upload files smaller than 50MB.`);
    return;
  }

  const ext = file.name.split('.').pop().toLowerCase();
  const fileBox = document.createElement('div');
  fileBox.className = 'file-box';

  const fileName = document.createElement('p');
  fileName.textContent = file.name;
  fileBox.appendChild(fileName);

  const deleteBtn = document.createElement('button');
  deleteBtn.className = 'delete-btn';
  deleteBtn.textContent = 'x';
  deleteBtn.title = 'Delete this file';
  deleteBtn.onclick = (e) => {
    e.stopPropagation();
    fileBox.remove();
  };
  fileBox.appendChild(deleteBtn);

  const iframe = document.createElement('iframe');
  iframe.classList.add('no-copy');

  if (ext === 'pdf') {
    const reader = new FileReader();
    reader.onload = function (event) {
      iframe.src = event.target.result;
      fileBox.appendChild(iframe);
      fileBox.addEventListener('click', () => {
        const bigIframe = document.createElement('iframe');
        bigIframe.src = event.target.result;
        openModal(bigIframe);
      });
    };
    reader.readAsDataURL(file);
  } else if (ext === 'txt') {
    const reader = new FileReader();
    reader.onload = function (event) {
      const html = `<pre style="white-space:pre-wrap; padding:10px; font-size:14px;">${event.target.result}</pre>`;
      iframe.srcdoc = html;
      fileBox.appendChild(iframe);
      fileBox.addEventListener('click', () => {
        const large = document.createElement('div');
        large.innerHTML = html;
        openModal(large);
      });
    };
    reader.readAsText(file);
  } else if (ext === 'docx') {
    const reader = new FileReader();
    reader.onload = function (event) {
      mammoth.convertToHtml({ arrayBuffer: event.target.result })
        .then(result => {
          const html = `<div style="padding:10px; font-size:14px;">${result.value}</div>`;
          iframe.srcdoc = html;
          fileBox.appendChild(iframe);
          fileBox.addEventListener('click', () => {
            const large = document.createElement('div');
            large.innerHTML = html;
            openModal(large);
          });
        });
    };
    reader.readAsArrayBuffer(file);
  } else {
    const msg = document.createElement('p');
    msg.textContent = 'Preview not supported.';
    fileBox.appendChild(msg);
  }

  fileList.appendChild(fileBox);
}

  </script>
